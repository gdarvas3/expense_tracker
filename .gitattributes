# Normalize line endings: LF in the repository and in the working tree on every OS.
* text=auto eol=lf

# Windows-only scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: no line-ending conversion or text diff.
*.png binary
*.jpg binary
*.ico binary
*.db binary
